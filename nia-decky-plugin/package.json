{
  "name": "nia-decky",
  "version": "0.3.0",
  "description": "Decky Loader companion that narrates the active game using low-frequency monitoring and user-marked events.",
  "type": "module",
  "scripts": {
    "build": "pnpm exec esbuild src/index.tsx --bundle --format=esm --target=es2020 --jsx=automatic --external:@decky/api --external:@decky/ui --external:react --external:react-dom --external:react/jsx-runtime --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "python3 -m unittest discover -s tests"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.0"
  },
  "devDependencies": {
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "esbuild": "0.21.5",
    "eslint": "8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "typescript": "5.4.5"
  }
}
