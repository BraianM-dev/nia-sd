{
  "name": "nia-decky",
  "version": "0.1.0",
  "description": "Decky Loader plugin para generar narrativa interactiva con IA y TTS.",
  "type": "module",
  "scripts": {
    "build": "pnpm exec esbuild src/index.tsx --bundle --format=esm --target=es2020 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "pack": "bash scripts/pack.sh"
  },
  "dependencies": {
    "@decky/ui": "3.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/react": "18.2.56",
    "@types/react-dom": "18.2.19",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "esbuild": "0.21.5",
    "eslint": "8.57.0",
    "typescript": "5.4.5"
  }
}
