#!/usr/bin/env bash
set -euo pipefail
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nia-decky"
mkdir -p "$CACHE_DIR"
TARGET="$CACHE_DIR/piper_bin"

URL_DEFAULT="https://github.com/rhasspy/piper/releases/download/v1.2.0/piper_linux_x86_64"
URL="${PIPER_URL:-$URL_DEFAULT}"

if [[ ! -x "$TARGET" ]]; then
  echo "[piper] Descargando binario Piper desde $URL" >&2
  tmp="$(mktemp "$CACHE_DIR/piper.XXXX")"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --output "$tmp" "$URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$tmp" "$URL"
  else
    echo "[piper] Necesita curl o wget" >&2
    exit 1
  fi
  chmod +x "$tmp"
  mv "$tmp" "$TARGET"
fi

exec "$TARGET" "$@"
